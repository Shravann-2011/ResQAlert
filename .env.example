# Environment Configuration
DEBUG=False

# Database
DATABASE_URL=sqlite:///resqalert.db

# Weather API
# Get your free API key from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Twilio SMS Service
# Sign up at: https://www.twilio.com/try-twilio
# For trial accounts, verify phone numbers at: https://console.twilio.com/us1/develop/phone-numbers/manage/verified
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# SendGrid Email Service (Optional)
# Sign up at: https://sendgrid.com/
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Email Settings
FROM_EMAIL=alerts@resqalert.com
